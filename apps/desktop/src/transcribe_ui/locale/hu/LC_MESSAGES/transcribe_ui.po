#: src/transcribe_ui/i18n/error_texts.py
msgid "The folder to scan must be an absolute path."
msgstr "A beolvasandó mappát abszolút útvonallal kell megadni."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"The job and its {items} file will be deleted from this computer's job "
"list."
msgid_plural ""
"The job and its {items} files will be deleted from this computer's job "
"list."
msgstr[0] "A feladat és {items} fájlja törlődik e számítógép feladatlistájáról."
msgstr[1] "A feladat és {items} fájlja törlődik e számítógép feladatlistájáról."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The job database cannot be opened; the details are in the log."
