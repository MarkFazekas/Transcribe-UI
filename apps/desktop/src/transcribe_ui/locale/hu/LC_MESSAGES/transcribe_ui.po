msgid "The name is not valid Unicode; rename it to include it."
msgstr "A név nem érvényes Unicode-szöveg; nevezze át, hogy bekerülhessen."

#: src/transcribe_ui/i18n/code_texts.py
msgid "The output folder is not an absolute path."
msgstr "A kimeneti mappa nem abszolút útvonal."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The path to scan is not a folder."
msgstr "A beolvasandó útvonal nem mappa."

