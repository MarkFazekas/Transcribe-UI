msgid "The settings cannot be saved; the details are in the log."
msgstr "A beállítások nem menthetők; a részletek a naplóban olvashatók."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"The settings file cannot be read or is not valid; save the settings to "
