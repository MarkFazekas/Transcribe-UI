#: src/transcribe_ui/gui/settings/form.py
msgid "A change applies after a restart."
msgstr "A változás újraindítás után lép életbe."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A choice does not fit its file."
msgstr "Egy választás nem illik a fájljához."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"A cloud cleanup was interrupted; repeat the cleanup of these jobs before "
"starting a cloud machine: {batch_ids}."
msgstr ""
"Egy felhőtakarítás megszakadt; felhőgép indítása előtt ismételje meg "
"ezeknek a feladatoknak a takarítását: {batch_ids}."

#: src/transcribe_ui/gui/cloud/view.py
msgid ""
"A cloud machine is left over or past its time limit and may still cost "
"money."
msgstr ""
"Egy felhőgép megmaradt vagy túllépte az időkorlátját, és még pénzbe "
"kerülhet."

#: src/transcribe_ui/gui/cloud/status.py
msgid "A cloud machine needs attention"
msgstr "Egy felhőgép figyelmet igényel"

#: src/transcribe_ui/i18n/error_texts.py
msgid "A cloud run is active; nothing was changed. Try again once it has ended."
msgstr ""
"Egy felhős futás folyamatban van; semmi sem változott. Próbálja újra, ha "
"véget ért."

#: src/transcribe_ui/gui/cleanup/display.py
#, python-brace-format
msgid ""
"A cloud step of job {batch_id} is still running in the activity panel "
"below."
msgstr ""
"A {batch_id} feladat egyik felhőbeli lépése még fut; a lenti "
"tevékenységpanelen látható."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"A duplicate of {name} ({object_id}) is in use and cannot be removed. "
"Terminate the cloud machines using it, then run the cloud setup again."
msgstr ""
"{name} egyik másodpéldánya ({object_id}) használatban van, ezért nem "
"törölhető. Szüntesse meg az ezt használó felhőgépeket, majd futtassa újra"
" a felhőbeállítást."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A file of the job cannot be read right now (is its drive or network share"
" connected?); try again once it can."
msgstr ""
"A feladat egyik fájlja most nem olvasható (csatlakoztatva van a "
"meghajtója vagy a hálózati megosztása?); próbálja újra, amikor már "
"olvasható."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A file with its own languages is not in the selection."
msgstr "Egy saját nyelvekkel megadott fájl nincs a kijelölésben."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A job cannot lose its last file; delete the job or clean it up from the "
"cloud instead."
msgstr ""
"Egy feladatból nem vehető ki az utolsó fájl; helyette törölje a "
"feladatot, vagy takarítsa el a felhőből."

#: src/transcribe_ui/i18n/credential_texts.py
#, python-brace-format
msgid ""
"A key must be ASCII without spaces or control characters, at most "
"{max_length} characters, and not only '*' characters."
msgstr ""
"A kulcs csak ASCII-karakterekből állhat, szóköz és vezérlőkarakter "
"nélkül, legfeljebb {max_length} karakter hosszú lehet, és nem állhat "
"csupa „*” karakterből."

#: src/transcribe_ui/gui/cloud/sections.py
msgid ""
"A machine is left over or past its time limit: stop it, so it costs no "
"more."
msgstr ""
"Egy gép megmaradt vagy túllépte az időkorlátját: állítsa le, hogy ne "
"kerüljön több pénzbe."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A retried file has no audio to copy for one of its transcriptions."
msgstr "Egy újrapróbált fájl egyik átírásához nincs átmásolható hang."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A retry of this job is still copying its audio; finish or clean up the "
"retry job first."
msgstr ""
"A feladat egyik újrapróbálása még másolja a hangját; előbb fejezze be "
"vagy takarítsa el az újrapróbáló feladatot."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A selected path is not inside the scanned folder."
msgstr "Egy kijelölt útvonal nincs a beolvasott mappán belül."

#: src/transcribe_ui/gui/cloud/start_view.py
msgid ""
"A transcription is running: Start waits until it ends or is stopped on "
"the Cloud page."
msgstr ""
"Átírás fut: az Indítás megvárja, amíg befejeződik, vagy amíg a Felhő "
"oldalon leállítja."

#: src/transcribe_ui/gui/cloud/run_panel.py
msgid "A transcription is running; it ends by itself, or stop it first."
msgstr "Egy átírás fut; magától befejeződik, vagy előbb állítsa le."

#: src/transcribe_ui/gui/settings/texts.py
msgid "About"
msgstr "Névjegy"

#: src/transcribe_ui/gui/settings/texts.py
msgid "Accounts"
msgstr "Fiókok"

#: src/transcribe_ui/gui/cloud/start_view.py
msgid "Advanced"
msgstr "Speciális"

#: src/transcribe_ui/gui/review/folders.py
msgid "All folders"
msgstr "Minden mappa"

#: src/transcribe_ui/gui/settings/texts.py
msgid "All in one output folder"
msgstr "Mind egy kimeneti mappába"

#: src/transcribe_ui/gui/settings/texts.py
msgid "All in one output folder, with folder names in the file name"
msgstr "Mind egy kimeneti mappába, a fájlnévben a mappák nevével"

#: src/transcribe_ui/gui/jobs/view.py
msgid "All jobs"
msgstr "Összes feladat"

#: src/transcribe_ui/i18n/code_texts.py
msgid ""
"All of the job's data will be deleted from the cloud: audio, subtitles "
"and its description."
msgstr ""
"A feladat minden adata törlődik a felhőből: a hang, a feliratok és a "
"feladat leírása."

#: src/transcribe_ui/gui/download/panels.py
msgid "Also place empty subtitles (no speech was found)"
msgstr "Az üres feliratokat is elhelyezi (ahol nem volt beszéd)"

#: src/transcribe_ui/i18n/error_texts.py
msgid "An audio file is uploaded as it is; it takes no track choice."
msgstr ""
"A hangfájl változatlanul töltődik fel; hangsávot nem kell hozzá "
"választani."

#: src/transcribe_ui/i18n/error_texts.py
msgid "An uploaded audio file could not be verified in the cloud; upload again."
msgstr "Egy feltöltött hangfájl nem ellenőrizhető a felhőben; töltse fel újra."

#: src/transcribe_ui/gui/pages.py
msgid ""
"Another Transcribe-UI (a second window or a command-line run) is using "
"the job database. Settings, accounts and the cloud setup stay usable; "
"close the other one, then Retry."
msgstr ""
"Egy másik Transcribe-UI (egy második ablak vagy egy parancssori futtatás)"
" használja a feladatok adatbázisát. A beállítások, a fiókok és a "
"felhőbeállítás továbbra is használhatók; zárja be a másikat, majd "
"kattintson az Újra gombra."

#: src/transcribe_ui/gui/cloud/plan_display.py
msgid "Another computer"
msgstr "Másik számítógép"

#: src/transcribe_ui/i18n/error_texts.py
msgid "Another task is working on the cloud runs; try again to continue."
msgstr ""
"Egy másik művelet a felhős futásokon dolgozik; a folytatáshoz próbálja "
"újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Another task is working on this job; try again when it has finished."
msgstr "Egy másik művelet ezen a feladaton dolgozik; próbálja újra, ha végzett."

#: src/transcribe_ui/gui/review/view.py
msgid "Apply choices"
msgstr "Választások alkalmazása"

#: src/transcribe_ui/gui/review/status.py
msgid "Apply or discard your changes before changing the filters or uploading."
msgstr ""
"A szűrők módosítása vagy a feltöltés előtt alkalmazza vagy vesse el a "
"módosításait."

