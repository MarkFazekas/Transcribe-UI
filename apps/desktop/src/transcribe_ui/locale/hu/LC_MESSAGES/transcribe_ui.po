#, python-brace-format
msgid "{items} file will be removed from the job."
msgid_plural "{items} files will be removed from the job."
msgstr[0] "{items} fájl kikerül a feladatból."
msgstr[1] "{items} fájl kikerül a feladatból."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"{items} file will be removed from the job. Its audio already uploaded to "
"the cloud is deleted."
msgid_plural ""
"{items} files will be removed from the job. Their audio already uploaded "
"to the cloud is deleted."
msgstr[0] ""
"{items} fájl kikerül a feladatból. A felhőbe már feltöltött hangja "
"törlődik."
msgstr[1] ""
"{items} fájl kikerül a feladatból. A felhőbe már feltöltött hangjuk "
"törlődik."

