#: src/transcribe_ui/i18n/error_texts.py
msgid "A choice does not fit its file."
msgstr "Egy választás nem illik a fájljához."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"A cloud cleanup was interrupted; repeat the cleanup of these jobs before "
"starting a cloud machine: {batch_ids}."
msgstr ""
"Egy felhőtakarítás megszakadt; felhőgép indítása előtt ismételje meg "
"ezeknek a feladatoknak a takarítását: {batch_ids}."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A cloud run is active; nothing was changed. Try again once it has ended."
msgstr ""
"Egy felhős futás folyamatban van; semmi sem változott. Próbálja újra, ha "
"véget ért."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"A duplicate of {name} ({object_id}) is in use and cannot be removed. "
"Terminate the cloud machines using it, then run the cloud setup again."
msgstr ""
"{name} egyik másodpéldánya ({object_id}) használatban van, ezért nem "
"törölhető. Szüntesse meg az ezt használó felhőgépeket, majd futtassa újra"
" a felhőbeállítást."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A file of the job cannot be read right now (is its drive or network share"
" connected?); try again once it can."
msgstr ""
"A feladat egyik fájlja most nem olvasható (csatlakoztatva van a "
"meghajtója vagy a hálózati megosztása?); próbálja újra, amikor már "
"olvasható."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A file with its own languages is not in the selection."
msgstr "Egy saját nyelvekkel megadott fájl nincs a kijelölésben."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A job cannot lose its last file; delete the job or clean it up from the "
"cloud instead."
msgstr ""
"Egy feladatból nem vehető ki az utolsó fájl; helyette törölje a "
"feladatot, vagy takarítsa el a felhőből."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A retried file has no audio to copy for one of its transcriptions."
msgstr "Egy újrapróbált fájl egyik átírásához nincs átmásolható hang."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"A retry of this job is still copying its audio; finish or clean up the "
"retry job first."
msgstr ""
"A feladat egyik újrapróbálása még másolja a hangját; előbb fejezze be "
"vagy takarítsa el az újrapróbáló feladatot."

#: src/transcribe_ui/i18n/error_texts.py
msgid "A selected path is not inside the scanned folder."
msgstr "Egy kijelölt útvonal nincs a beolvasott mappán belül."

#: src/transcribe_ui/i18n/code_texts.py
msgid ""
"All of the job's data will be deleted from the cloud: audio, subtitles "
"and its description."
msgstr ""
"A feladat minden adata törlődik a felhőből: a hang, a feliratok és a "
"feladat leírása."

#: src/transcribe_ui/i18n/error_texts.py
msgid "An audio file is uploaded as it is; it takes no track choice."
msgstr ""
"A hangfájl változatlanul töltődik fel; hangsávot nem kell hozzá "
"választani."

#: src/transcribe_ui/i18n/error_texts.py
msgid "An uploaded audio file could not be verified in the cloud; upload again."
msgstr "Egy feltöltött hangfájl nem ellenőrizhető a felhőben; töltse fel újra."

#: src/transcribe_ui/gui/pages.py
msgid ""
"Another Transcribe-UI (a second window or a command-line run) is using "
"the job database. Settings, accounts and the cloud setup stay usable; "
"close the other one, then Retry."
msgstr ""
"Egy másik Transcribe-UI (egy második ablak vagy egy parancssori futtatás)"
" használja a feladatok adatbázisát. A beállítások, a fiókok és a "
"felhőbeállítás továbbra is használhatók; zárja be a másikat, majd "
"kattintson az Újra gombra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Another task is working on the cloud runs; try again to continue."
msgstr ""
"Egy másik művelet a felhős futásokon dolgozik; a folytatáshoz próbálja "
"újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Another task is working on this job; try again when it has finished."
msgstr "Egy másik művelet ezen a feladaton dolgozik; próbálja újra, ha végzett."

#: src/transcribe_ui/gui/activity_view.py
msgid "Cancel"
msgstr "Megszakítás"

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"Cancel the queued cloud machine {name} ({status})? Its work stops at "
"once; finished results stay in the cloud."
msgstr ""
"Visszavonja ezt a sorban álló felhőgépet: {name} ({status})? A munkája "
"azonnal leáll; a kész eredmények a felhőben maradnak."

#: src/transcribe_ui/i18n/code_texts.py
msgid "Checking files"
msgstr "Fájlok ellenőrzése"

#: src/transcribe_ui/i18n/error_texts.py
msgid "Choose the audio track to transcribe."
msgstr "Válassza ki az átírandó hangsávot."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Choose the subtitle stream to extract."
msgstr "Válassza ki a kinyerendő feliratsávot."

#: src/transcribe_ui/gui/dialogs.py
msgid "Close Transcribe-UI"
msgstr "A Transcribe-UI bezárása"

#: src/transcribe_ui/gui/dialogs.py
msgid "Closing"
msgstr "Bezárás"

#: src/transcribe_ui/gui/texts.py
msgid "Cloud"
msgstr "Felhő"

#: src/transcribe_ui/gui/dialogs.py
#, python-brace-format
msgid "Code: {code}"
msgstr "Kód: {code}"

#: src/transcribe_ui/gui/dialogs.py
msgid "Confirm"
msgstr "Megerősítés"

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Creating {name} on Runpod failed after the request was sent, so it may "
"exist already. Run the cloud setup again in a minute; it takes over what "
"was created."
msgstr ""
"{name} létrehozása a Runpodon a kérés elküldése után hiúsult meg, így "
"lehet, hogy már létezik. Egy perc múlva futtassa újra a felhőbeállítást; "
"az átveszi, ami létrejött."

#: src/transcribe_ui/i18n/code_texts.py
msgid "Deleting from the cloud"
msgstr "Törlés a felhőből"

#: src/transcribe_ui/gui/dialogs.py
msgid "Detail"
msgstr "Adat"

#: src/transcribe_ui/gui/activity_view.py src/transcribe_ui/gui/dialogs.py
msgid "Details"
msgstr "Részletek"

#: src/transcribe_ui/gui/activity_view.py
msgid "Dismiss"
msgstr "Elrejtés"

#: src/transcribe_ui/i18n/code_texts.py
msgid "Downloading subtitles"
msgstr "Feliratok letöltése"

#: src/transcribe_ui/gui/texts.py
msgid "Failed"
msgstr "Sikertelen"

#: src/transcribe_ui/gui/texts.py
msgid "Finished"
msgstr "Kész"

#: src/transcribe_ui/gui/closing.py
msgid "Finishing the current step..."
msgstr "Az aktuális lépés befejezése..."

#: src/transcribe_ui/i18n/code_texts.py
msgid "Folder names were added to tell apart files of different folders."
msgstr ""
"A név mappanevekkel egészült ki, hogy a különböző mappák fájljai "
"megkülönböztethetők legyenek."

#: src/transcribe_ui/i18n/code_texts.py
msgid "Folders this deep are not scanned."
msgstr "Az alkalmazás ilyen mélyen lévő mappákat nem olvas be."

#: src/transcribe_ui/gui/texts.py
msgid "Jobs"
msgstr "Feladatok"

#: src/transcribe_ui/i18n/code_texts.py
msgid "Links are not followed."
msgstr "Az alkalmazás a hivatkozásokat nem követi."

#: src/transcribe_ui/gui/texts.py
msgid "New job"
msgstr "Új feladat"

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"No display is available for the window. Use the transcribe-ui command "
"line instead."
msgstr ""
"Nincs elérhető kijelző az ablakhoz. Használja helyette a transcribe-ui "
"parancssort."

#: src/transcribe_ui/i18n/code_texts.py
msgid "No media file is at or below this path."
msgstr "Ezen az útvonalon és alatta nincs médiafájl."

#: src/transcribe_ui/gui/shell.py
msgid "Not available yet."
msgstr "Még nem érhető el."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Only transcriptions that failed or found no speech can be retried."
msgstr "Csak a sikertelen és a beszédet nem találó átírások próbálhatók újra."

#: src/transcribe_ui/gui/texts.py
msgid "Open accounts"
msgstr "Fiókok megnyitása"

#: src/transcribe_ui/gui/texts.py
msgid "Open cloud setup"
msgstr "Felhőbeállítás megnyitása"

#: src/transcribe_ui/gui/dialogs.py
msgid "Open log folder"
msgstr "Naplómappa megnyitása"

#: src/transcribe_ui/gui/texts.py
msgid "Open the job"
msgstr "A feladat megnyitása"

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"Picture-based subtitles cannot be extracted as text; they can only be "
"transcribed."
msgstr "A képalapú feliratok nem nyerhetők ki szövegként; csak átírhatók."

#: src/transcribe_ui/gui/dialogs.py
msgid "Please confirm"
msgstr "Megerősítés szükséges"

#: src/transcribe_ui/gui/dialogs.py
msgid "Quit now"
msgstr "Kilépés most"

#: src/transcribe_ui/i18n/code_texts.py
msgid "R2 accepted the credentials and the bucket can be listed."
msgstr "Az R2 elfogadta a hozzáférési adatokat, és a bucket tartalma listázható."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"R2 accepted the credentials, but they are not allowed to do this; check "
"the API token's permissions and bucket."
msgstr ""
"Az R2 elfogadta a hozzáférési adatokat, de ehhez nincs joguk; ellenőrizze"
" az API-token jogosultságait és bucketjét."

#: src/transcribe_ui/i18n/error_texts.py
msgid "R2 cannot be reached; check the network connection and the endpoint URL."
msgstr ""
"Az R2 nem érhető el; ellenőrizze a hálózati kapcsolatot és a végpont URL-"
"jét."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"R2 refused the credentials: the access key ID or the secret access key is"
" wrong."
msgstr ""
"Az R2 elutasította a hozzáférési adatokat: a hozzáférésikulcs-azonosító "
"vagy a titkos hozzáférési kulcs hibás."

#: src/transcribe_ui/gui/activity_view.py
msgid "Resume"
msgstr "Folytatás"

#: src/transcribe_ui/gui/pages.py src/transcribe_ui/gui/texts.py
msgid "Retry"
msgstr "Újra"

#: src/transcribe_ui/cli/parser.py
msgid "Run Transcribe-UI requests from JSON files."
msgstr "Transcribe-UI-kérések futtatása JSON-fájlokból."

#: src/transcribe_ui/gui/texts.py
msgid "Running"
msgstr "Fut"

#: src/transcribe_ui/i18n/code_texts.py
msgid "Runpod accepted the API key and the cloud machines can be listed."
msgstr "A Runpod elfogadta az API-kulcsot, és a felhőgépek listázhatók."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Runpod cannot be reached or answered unexpectedly ({cause}). Try again "
"later."
msgstr ""
"A Runpod nem érhető el, vagy váratlan választ adott ({cause}). Próbálja "
"újra később."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"Runpod did not create the cloud machine; nothing was started. Check the "
"Runpod account, then try again."
msgstr ""
"A Runpod nem hozta létre a felhőgépet; semmi sem indult el. Ellenőrizze a"
" Runpod-fiókot, majd próbálja újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Runpod does not know this cloud machine."
msgstr "A Runpod nem ismeri ezt a felhőgépet."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Runpod holds {count} Global Volumes named {name}. They may hold result "
"backups, so the app deletes none of them: delete the ones you do not need"
" in the Runpod console (Storage page), then run the cloud setup again."
msgstr ""
"A Runpodon {count} darab {name} nevű Global Volume van. Ezek "
"eredménymentéseket tárolhatnak, ezért az alkalmazás egyiket sem törli: a "
"feleslegeseket törölje a Runpod konzolján (Storage oldal), majd futtassa "
"újra a felhőbeállítást."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"Runpod rejected the API key (expired, revoked or mistyped). Enter a valid"
" key."
msgstr ""
"A Runpod elutasította az API-kulcsot (lejárt, visszavonták vagy "
"elgépelték). Adjon meg egy érvényes kulcsot."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Runpod reports that {name} exists but does not list it yet. Run the cloud"
" setup again in a minute."
msgstr ""
"A Runpod szerint {name} létezik, de még nem szerepel a listájában. Egy "
"perc múlva futtassa újra a felhőbeállítást."

#: src/transcribe_ui/i18n/code_texts.py
msgid "Scanning folders"
msgstr "Mappák beolvasása"

#: src/transcribe_ui/gui/dialogs.py
msgid "See the log for what went wrong."
msgstr "A hiba oka a naplóban olvasható."

#: src/transcribe_ui/gui/texts.py
msgid "Settings"
msgstr "Beállítások"

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Some credentials are not set: {missing}. Enter them under Settings, "
"Accounts."
msgstr ""
"Néhány hozzáférési adat nincs megadva: {missing}. Adja meg őket a "
"Beállítások, Fiókok oldalon."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"Some credentials are not set: {missing}. The keyring cannot be used; set "
"the environment variables {variables}."
msgstr ""
"Néhány hozzáférési adat nincs megadva: {missing}. A kulcstartó nem "
"használható; állítsa be ezeket a környezeti változókat: {variables}."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "Some credentials are not valid: {invalid}. Enter them again."
msgstr "Néhány hozzáférési adat érvénytelen: {invalid}. Adja meg őket újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"Some files of the job have no result yet, so their audio is still needed;"
" wait for the transcription, or delete everything instead."
msgstr ""
"A feladat néhány fájljának még nincs eredménye, ezért a hangjukra még "
"szükség van; várja meg az átírást, vagy helyette töröljön mindent."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Something unexpected went wrong; the details are in the log."
msgstr "Váratlan hiba történt; a részletek a naplóban olvashatók."

#: src/transcribe_ui/gui/dialogs.py
msgid "Something went wrong"
msgstr "Hiba történt"

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"Start a cloud machine for {jobs} transcription ({audio_s:duration} of "
"audio); estimated cost {cost_low_usd:.2f}-{cost_high_usd:.2f} USD."
msgid_plural ""
"Start a cloud machine for {jobs} transcriptions ({audio_s:duration} of "
"audio); estimated cost {cost_low_usd:.2f}-{cost_high_usd:.2f} USD."
msgstr[0] ""
"Egy felhőgép indul {jobs} átíráshoz ({audio_s:duration} hanganyag); a "
"becsült költség {cost_low_usd:.2f}–{cost_high_usd:.2f} USD."
msgstr[1] ""
"Egy felhőgép indul {jobs} átíráshoz ({audio_s:duration} hanganyag); a "
"becsült költség {cost_low_usd:.2f}–{cost_high_usd:.2f} USD."

#: src/transcribe_ui/gui/dialogs.py
msgid "Stop and close"
msgstr "Leállítás és bezárás"

#: src/transcribe_ui/gui/closing.py
msgid ""
"Stop and close? The work continues from where it stopped the next time "
"you start it."
msgstr ""
"Leállítja és bezárja? A munka a következő indításkor onnan folytatódik, "
"ahol abbamaradt."

#: src/transcribe_ui/i18n/error_texts.py
msgid "Stopped. The work done so far is saved; continue any time."
msgstr "Leállítva. Az eddig elvégzett munka mentve van; bármikor folytatható."

#: src/transcribe_ui/gui/texts.py
msgid "Stopped; continue any time."
msgstr "Leállítva; bármikor folytatható."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"Terminate the cloud machine {name} ({status})? Its work stops at once; "
"finished results stay in the cloud."
msgstr ""
"Megszünteti ezt a felhőgépet: {name} ({status})? A munkája azonnal leáll;"
" a kész eredmények a felhőben maradnak."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The R2 bucket does not exist; check the bucket name and the endpoint URL."
msgstr "Az R2-bucket nem létezik; ellenőrizze a bucket nevét és a végpont URL-jét."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The R2 object to copy does not exist."
msgstr "A másolandó R2-objektum nem létezik."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The R2 request failed; the details are in the log."
msgstr "Az R2-kérés nem sikerült; a részletek a naplóban olvashatók."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"The Runpod API key lacks the permission {scope}. Create a key with the "
"permissions the app lists."
msgstr ""
"A Runpod API-kulcsából hiányzik ez a jogosultság: {scope}. Hozzon létre "
"egy kulcsot az alkalmazás által felsorolt jogosultságokkal."

#: src/transcribe_ui/i18n/code_texts.py
msgid ""
"The Runpod price list does not list the GPU; the estimate uses the usual "
"price."
msgstr "A Runpod árlistáján nem szerepel a GPU; a becslés a szokásos árral számol."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"The cloud already holds data under this job's ID (another computer's job,"
" or one of an earlier installation); delete this job and create it again,"
" which gives it a new ID."
msgstr ""
"A felhőben már vannak adatok ennek a feladatnak az azonosítójával (egy "
"másik számítógép feladata, vagy egy korábbi telepítésé); törölje ezt a "
"feladatot, és hozza létre újra, így új azonosítót kap."

#: src/transcribe_ui/gui/closing.py
msgid ""
"The cloud machine keeps working without the app: it stops itself when the"
" work is done or at its time limit, and the app shows its results the "
"next time it starts."
msgstr ""
"A felhőgép az alkalmazás nélkül is tovább dolgozik: magától leáll, amikor"
" elkészül a munkával vagy lejár az ideje, és az alkalmazás a következő "
"indításkor megmutatja az eredményeit."

#: src/transcribe_ui/i18n/code_texts.py
msgid "The cloud machine left no result for the transcription."
msgstr "A felhőgép nem hagyott eredményt az átíráshoz."

#: src/transcribe_ui/i18n/error_texts.py
msgid ""
"The cloud machine may still be running: Runpod does not show it stopped "
"yet. Try again."
msgstr ""
"Lehet, hogy a felhőgép még fut: a Runpod még nem mutatja leállítottnak. "
"Próbálja újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The cloud run has ended already; there is nothing to stop."
msgstr "A felhős futás már véget ért; nincs mit leállítani."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "The cloud run {run_id} does not exist."
msgstr "Nincs {run_id} azonosítójú felhős futás."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The cloud setup is incomplete. Run the cloud setup first."
msgstr "A felhőbeállítás hiányos. Először futtassa a felhőbeállítást."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The cloud setup is outdated. Run the cloud setup again."
msgstr "A felhőbeállítás elavult. Futtassa újra a felhőbeállítást."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "The cloud setup was interrupted at {name}. Run it again in a minute."
msgstr "A felhőbeállítás megszakadt ennél: {name}. Egy perc múlva futtassa újra."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The command line is not valid."
msgstr "A parancssor érvénytelen."

#: src/transcribe_ui/i18n/error_texts.py
msgid "The converted audio cannot be written or read back; try again."
msgstr ""
"Az átalakított hang nem írható ki vagy nem olvasható vissza; próbálja "
"újra."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "The converted audio cannot be written: {reason}"
msgstr "Az átalakított hang nem írható ki: {reason}"

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "The custom plan does not match its format: {problems}"
msgstr "Az egyéni terv nem felel meg a formátumának: {problems}"

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "The custom plan file cannot be read ({reason})."
msgstr "Az egyéni terv fájlja nem olvasható ({reason})."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid "The custom plan file cannot be written ({reason})."
msgstr "Az egyéni terv fájlja nem írható ({reason})."

#: src/transcribe_ui/i18n/code_texts.py
msgid ""
"The file changed while it was checked; review the job again once it is "
"complete."
msgstr ""
"A fájl megváltozott az ellenőrzése közben; tekintse át újra a feladatot, "
