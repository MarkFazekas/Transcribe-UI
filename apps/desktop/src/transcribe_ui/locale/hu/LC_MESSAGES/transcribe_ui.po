msgstr "{minutes} p {seconds} mp"

#: src/transcribe_ui/i18n/formats.py
#, python-brace-format
msgid "{seconds} s"
msgstr "{seconds} mp"

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
