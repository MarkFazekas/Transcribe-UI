msgstr "{file} ({language}): az output_file_name nem .srt végű."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"{file} ({language}): source_path or original_folder was changed in the "
"plan."
msgstr ""
"{file} ({language}): a tervben módosult a source_path vagy az "
"original_folder."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the file is not inside the scanned folder."
msgstr "{file} ({language}): a fájl nincs a beolvasott mappán belül."

