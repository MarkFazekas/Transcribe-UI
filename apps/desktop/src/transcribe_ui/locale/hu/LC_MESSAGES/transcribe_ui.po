#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): {name} is a name Windows reserves for a device."
msgstr ""
"{file} ({language}): ezt a nevet a Windows egy eszköznek tartja fenn: "
"{name}"

