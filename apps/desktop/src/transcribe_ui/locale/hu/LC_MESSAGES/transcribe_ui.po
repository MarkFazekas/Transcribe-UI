#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the subtitle is not in the cloud any more."
msgstr "{file} ({language}): a felirat már nincs a felhőben."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid ""
"{file} ({language}): the subtitle name {name} is too long for the target "
"(with the tail of its temporary file, at most {max_length} characters)."
msgstr ""
"{file} ({language}): a felirat neve túl hosszú a célhelyhez (az "
"ideiglenes fájl végződésével együtt legfeljebb {max_length} karakter "
"lehet): {name}"

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the target cannot be checked (no permission)."
msgstr "{file} ({language}): a célhely nem ellenőrizhető (nincs jogosultság)."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the target exists and is not a file."
msgstr "{file} ({language}): a célhelyen már van valami, és az nem fájl."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the target is outside the output folder."
msgstr "{file} ({language}): a célhely a kimeneti mappán kívül van."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the target path is longer than Windows allows."
msgstr ""
"{file} ({language}): a célhely útvonala hosszabb, mint amit a Windows "
