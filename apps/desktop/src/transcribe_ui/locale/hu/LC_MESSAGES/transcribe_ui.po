#, python-brace-format
msgid "{file} ({language}): the file's path is not absolute or contains '..'."
msgstr ""
"{file} ({language}): a fájl útvonala nem abszolút, vagy '..' szerepel "
"benne."

#: src/transcribe_ui/i18n/code_texts.py
#, python-brace-format
msgid "{file} ({language}): the name {name} cannot be used on the target."
msgstr "{file} ({language}): ez a név nem használható a célhelyen: {name}"

