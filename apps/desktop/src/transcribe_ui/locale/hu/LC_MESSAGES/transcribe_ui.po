msgid "The job's upload is not complete yet; finish the upload first."
msgstr "A feladat feltöltése még nem fejeződött be; előbb fejezze be a feltöltést."

#: src/transcribe_ui/i18n/error_texts.py
#, python-brace-format
msgid ""
"The keyring refused to store the credentials ({reason}). Unlock it and "
