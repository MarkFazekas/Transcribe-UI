{
  "$defs": {
    "BatchId": {
      "pattern": "^batch_[0-9]{8}_[0-9]{6}(?:_[2-9]|_[1-9][0-9]+)?$",
      "type": "string"
    },
    "BucketName": {
      "type": "string"
    },
    "CheckCredentialsRequest": {
      "additionalProperties": false,
      "description": "Try the credentials against the services (R2: list the bucket; Runpod: read the pod list); changes nothing.",
      "properties": {
        "action": {
          "const": "check_credentials",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "CheckCredentialsRequest",
      "type": "object"
    },
    "CloudSetupStatusRequest": {
      "additionalProperties": false,
      "description": "Report which Runpod objects of the setup are missing, outdated or duplicated; changes nothing.",
      "properties": {
        "action": {
          "const": "cloud_setup_status",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "CloudSetupStatusRequest",
      "type": "object"
    },
    "CreateBatchRequest": {
      "additionalProperties": false,
      "description": "Store a new batch in `composing` from a selection.",
      "properties": {
        "action": {
          "const": "create_batch",
          "title": "Action",
          "type": "string"
        },
        "confirm_existing_languages": {
          "default": false,
          "description": "Create jobs also for languages a file already has a subtitle in.",
          "title": "Confirm Existing Languages",
          "type": "boolean"
        },
        "item_languages": {
          "default": [],
          "description": "Other target languages for single files.",
          "items": {
            "$ref": "#/$defs/ItemLanguages"
          },
          "title": "Item Languages",
          "type": "array"
        },
        "languages": {
          "$ref": "#/$defs/TargetLanguages",
          "description": "Target languages of every selected file."
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/SelectionOperation"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/ScanSpec"
        },
        "scan_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse this scan of the same options if this process still keeps it; else scan again."
        }
      },
      "required": [
        "scan",
        "operations",
        "languages",
        "action"
      ],
      "title": "CreateBatchRequest",
      "type": "object"
    },
    "CredentialsStatusRequest": {
      "additionalProperties": false,
      "description": "Report which credentials are set and where from; never their values.",
      "properties": {
        "action": {
          "const": "credentials_status",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "CredentialsStatusRequest",
      "type": "object"
    },
    "DeleteBatchRequest": {
      "additionalProperties": false,
      "description": "Delete a batch in `composing` or `reviewing` (nothing of it is in the cloud yet).",
      "properties": {
        "action": {
          "const": "delete_batch",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        }
      },
      "required": [
        "action",
        "batch_id"
      ],
      "title": "DeleteBatchRequest",
      "type": "object"
    },
    "EditBatchRequest": {
      "additionalProperties": false,
      "description": "Replace the items of a batch in `composing` with a new selection.",
      "properties": {
        "action": {
          "const": "edit_batch",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "confirm_existing_languages": {
          "default": false,
          "description": "Create jobs also for languages a file already has a subtitle in.",
          "title": "Confirm Existing Languages",
          "type": "boolean"
        },
        "item_languages": {
          "default": [],
          "description": "Other target languages for single files.",
          "items": {
            "$ref": "#/$defs/ItemLanguages"
          },
          "title": "Item Languages",
          "type": "array"
        },
        "languages": {
          "$ref": "#/$defs/TargetLanguages",
          "description": "Target languages of every selected file."
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/SelectionOperation"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/ScanSpec"
        },
        "scan_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse this scan of the same options if this process still keeps it; else scan again."
        }
      },
      "required": [
        "scan",
        "operations",
        "languages",
        "action",
        "batch_id"
      ],
      "title": "EditBatchRequest",
      "type": "object"
    },
    "EndpointUrl": {
      "type": "string"
    },
    "ExcludeItemsRequest": {
      "additionalProperties": false,
      "description": "Remove items from a batch in `reviewing` or `uploading`, deleting their uploaded audio.",
      "properties": {
        "action": {
          "const": "exclude_items",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "item_ids": {
          "items": {
            "$ref": "#/$defs/Ulid"
          },
          "minItems": 1,
          "title": "Item Ids",
          "type": "array"
        }
      },
      "required": [
        "action",
        "batch_id",
        "item_ids"
      ],
      "title": "ExcludeItemsRequest",
      "type": "object"
    },
    "ExtractChoice": {
      "additionalProperties": false,
      "description": "Extract an embedded text subtitle stream as the job's subtitle.",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/Ulid"
        },
        "kind": {
          "const": "extract",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/WhisperLanguage"
        },
        "stream_index": {
          "minimum": 0,
          "title": "Stream Index",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "item_id",
        "language",
        "stream_index"
      ],
      "title": "ExtractChoice",
      "type": "object"
    },
    "FileExtension": {
      "pattern": "^[a-z0-9]{1,16}$",
      "type": "string"
    },
    "GetAppInfoRequest": {
      "additionalProperties": false,
      "description": "Ask for the app version and the data contract version (nothing machine-specific).",
      "properties": {
        "action": {
          "const": "get_app_info",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "GetAppInfoRequest",
      "type": "object"
    },
    "GetBatchRequest": {
      "additionalProperties": false,
      "description": "Return one batch with its items and jobs.",
      "properties": {
        "action": {
          "const": "get_batch",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        }
      },
      "required": [
        "action",
        "batch_id"
      ],
      "title": "GetBatchRequest",
      "type": "object"
    },
    "GetSettingsRequest": {
      "additionalProperties": false,
      "description": "Ask for the stored settings and every Whisper language (needs no database).",
      "properties": {
        "action": {
          "const": "get_settings",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "GetSettingsRequest",
      "type": "object"
    },
    "ItemLanguages": {
      "additionalProperties": false,
      "description": "Target languages of one selected file, instead of the batch's languages.",
      "properties": {
        "languages": {
          "$ref": "#/$defs/TargetLanguages"
        },
        "path": {
          "$ref": "#/$defs/LocalPath",
          "description": "The file's path exactly as the scan reported it."
        }
      },
      "required": [
        "path",
        "languages"
      ],
      "title": "ItemLanguages",
      "type": "object"
    },
    "LanguageCode": {
      "pattern": "^[a-z]{2,3}$",
      "type": "string"
    },
    "ListBatchesRequest": {
      "additionalProperties": false,
      "description": "List the batches, newest first.",
      "properties": {
        "action": {
          "const": "list_batches",
          "title": "Action",
          "type": "string"
        },
        "include_hidden": {
          "default": false,
          "title": "Include Hidden",
          "type": "boolean"
        }
      },
      "required": [
        "action"
      ],
      "title": "ListBatchesRequest",
      "type": "object"
    },
    "LocalPath": {
      "type": "string"
    },
    "MediaExtensions": {
      "items": {
        "$ref": "#/$defs/FileExtension"
      },
      "type": "array"
    },
    "NameFilter": {
      "additionalProperties": false,
      "description": "Match files by their name without the extension, ignoring case.",
      "properties": {
        "match": {
          "$ref": "#/$defs/NameMatch"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "match",
        "text"
      ],
      "title": "NameFilter",
      "type": "object"
    },
    "NameMatch": {
      "enum": [
        "starts_with",
        "ends_with",
        "contains",
        "regex"
      ],
      "type": "string"
    },
    "PlacementDefaults": {
      "additionalProperties": false,
      "description": "Placement choices a download request is pre-filled with (§3.5).",
      "properties": {
        "folder_count": {
          "exclusiveMinimum": 0,
          "title": "Folder Count",
          "type": "integer"
        },
        "output_folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "overwrite": {
          "title": "Overwrite",
          "type": "boolean"
        },
        "strategy": {
          "$ref": "#/$defs/PlacementStrategy"
        }
      },
      "required": [
        "strategy",
        "output_folder",
        "folder_count",
        "overwrite"
      ],
      "title": "PlacementDefaults",
      "type": "object"
    },
    "PlacementStrategy": {
      "enum": [
        "next_to_media",
        "mirror",
        "flat",
        "flat_with_folders"
      ],
      "type": "string"
    },
    "PreviewSelectionRequest": {
      "additionalProperties": false,
      "description": "Scan, then apply the selection operations in order; changes nothing.",
      "properties": {
        "action": {
          "const": "preview_selection",
          "title": "Action",
          "type": "string"
        },
        "operations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SelectionOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "scan": {
          "$ref": "#/$defs/ScanSpec"
        },
        "scan_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ulid"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reuse this scan of the same options if this process still keeps it; else scan again."
        }
      },
      "required": [
        "action",
        "scan"
      ],
      "title": "PreviewSelectionRequest",
      "type": "object"
    },
    "ResolveReviewRequest": {
      "additionalProperties": false,
      "description": "Set the choice of jobs in review; all choices are applied, or none.",
      "properties": {
        "action": {
          "const": "resolve_review",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/ReviewChoice"
          },
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "action",
        "batch_id",
        "choices"
      ],
      "title": "ResolveReviewRequest",
      "type": "object"
    },
    "ReviewBatchRequest": {
      "additionalProperties": false,
      "description": "Probe the files waiting for review, then return the review views.",
      "properties": {
        "action": {
          "const": "review_batch",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "filters": {
          "$ref": "#/$defs/ReviewFilter",
          "default": {
            "folder": null,
            "languages": []
          }
        }
      },
      "required": [
        "action",
        "batch_id"
      ],
      "title": "ReviewBatchRequest",
      "type": "object"
    },
    "ReviewChoice": {
      "discriminator": {
        "mapping": {
          "extract": "#/$defs/ExtractChoice",
          "transcribe": "#/$defs/TranscribeChoice"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TranscribeChoice"
        },
        {
          "$ref": "#/$defs/ExtractChoice"
        }
      ]
    },
    "ReviewFilter": {
      "additionalProperties": false,
      "description": "The main view's filters applied to the review views.",
      "properties": {
        "folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalPath"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only files at or below this folder."
        },
        "languages": {
          "default": [],
          "description": "Only jobs of these languages (all when empty).",
          "items": {
            "$ref": "#/$defs/WhisperLanguage"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "title": "ReviewFilter",
      "type": "object"
    },
    "ScanSpec": {
      "additionalProperties": false,
      "description": "What to scan and how to classify it; the GUI fills the defaults from the settings.",
      "properties": {
        "audio_extensions": {
          "default": [
            "aac",
            "ac3",
            "aif",
            "aiff",
            "amr",
            "ape",
            "dts",
            "eac3",
            "flac",
            "m4a",
            "m4b",
            "mka",
            "mp2",
            "mp3",
            "oga",
            "ogg",
            "opus",
            "wav",
            "wma",
            "wv"
          ],
          "items": {
            "$ref": "#/$defs/FileExtension"
          },
          "title": "Audio Extensions",
          "type": "array"
        },
        "include_hidden": {
          "default": false,
          "description": "Also scan hidden and system files and folders.",
          "title": "Include Hidden",
          "type": "boolean"
        },
        "root": {
          "$ref": "#/$defs/LocalPath",
          "description": "Absolute path of the folder to scan."
        },
        "video_extensions": {
          "default": [
            "3gp",
            "avi",
            "flv",
            "m2ts",
            "m4v",
            "mkv",
            "mov",
            "mp4",
            "mpeg",
            "mpg",
            "mts",
            "ogv",
            "ts",
            "vob",
            "webm",
            "wmv"
          ],
          "items": {
            "$ref": "#/$defs/FileExtension"
          },
          "title": "Video Extensions",
          "type": "array"
        }
      },
      "required": [
        "root"
      ],
      "title": "ScanSpec",
      "type": "object"
    },
    "ScanTreeRequest": {
      "additionalProperties": false,
      "description": "List the media files below a folder with their sidecar subtitles; changes nothing.",
      "properties": {
        "action": {
          "const": "scan_tree",
          "title": "Action",
          "type": "string"
        },
        "audio_extensions": {
          "default": [
            "aac",
            "ac3",
            "aif",
            "aiff",
            "amr",
            "ape",
            "dts",
            "eac3",
            "flac",
            "m4a",
            "m4b",
            "mka",
            "mp2",
            "mp3",
            "oga",
            "ogg",
            "opus",
            "wav",
            "wma",
            "wv"
          ],
          "items": {
            "$ref": "#/$defs/FileExtension"
          },
          "title": "Audio Extensions",
          "type": "array"
        },
        "include_hidden": {
          "default": false,
          "description": "Also scan hidden and system files and folders.",
          "title": "Include Hidden",
          "type": "boolean"
        },
        "root": {
          "$ref": "#/$defs/LocalPath",
          "description": "Absolute path of the folder to scan."
        },
        "video_extensions": {
          "default": [
            "3gp",
            "avi",
            "flv",
            "m2ts",
            "m4v",
            "mkv",
            "mov",
            "mp4",
            "mpeg",
            "mpg",
            "mts",
            "ogv",
            "ts",
            "vob",
            "webm",
            "wmv"
          ],
          "items": {
            "$ref": "#/$defs/FileExtension"
          },
          "title": "Video Extensions",
          "type": "array"
        }
      },
      "required": [
        "root",
        "action"
      ],
      "title": "ScanTreeRequest",
      "type": "object"
    },
    "SelectionFilter": {
      "additionalProperties": false,
      "description": "The filters active when an operation was made; every given part must match.",
      "properties": {
        "media_kind": {
          "default": "any",
          "enum": [
            "any",
            "audio",
            "video"
          ],
          "title": "Media Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subtitles": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubtitleFilter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "SelectionFilter",
      "type": "object"
    },
    "SelectionOperation": {
      "additionalProperties": false,
      "description": "Include or exclude the matching media files at or below a path (a folder or a file).",
      "properties": {
        "filters": {
          "$ref": "#/$defs/SelectionFilter",
          "default": {
            "media_kind": "any",
            "name": null,
            "subtitles": null
          }
        },
        "operation": {
          "enum": [
            "include",
            "exclude"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/LocalPath"
        }
      },
      "required": [
        "operation",
        "path"
      ],
      "title": "SelectionOperation",
      "type": "object"
    },
    "SetBatchHiddenRequest": {
      "additionalProperties": false,
      "description": "Hide a finished batch from the default list, or show it again.",
      "properties": {
        "action": {
          "const": "set_batch_hidden",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "hidden": {
          "title": "Hidden",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "batch_id",
        "hidden"
      ],
      "title": "SetBatchHiddenRequest",
      "type": "object"
    },
    "SetPath": {
      "minLength": 1,
      "type": "string"
    },
    "Settings": {
      "additionalProperties": false,
      "description": "The user's settings (all fields required; see `state.settings.default_settings`).",
      "properties": {
        "audio_extensions": {
          "$ref": "#/$defs/MediaExtensions"
        },
        "enabled_languages": {
          "items": {
            "$ref": "#/$defs/WhisperLanguage"
          },
          "minItems": 1,
          "title": "Enabled Languages",
          "type": "array"
        },
        "ffmpeg_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "ffprobe_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_hidden": {
          "title": "Include Hidden",
          "type": "boolean"
        },
        "placement": {
          "$ref": "#/$defs/PlacementDefaults"
        },
        "video_extensions": {
          "$ref": "#/$defs/MediaExtensions"
        }
      },
      "required": [
        "enabled_languages",
        "video_extensions",
        "audio_extensions",
        "include_hidden",
        "ffmpeg_path",
        "ffprobe_path",
        "placement"
      ],
      "title": "Settings",
      "type": "object"
    },
    "SetupCloudRequest": {
      "additionalProperties": false,
      "description": "Create or update, by their fixed names, the Runpod objects the worker needs.\n\nThe R2 secrets, the Global Volume and the worker template. Duplicate secrets and templates\nare deleted (one is kept: the exact-name, oldest secret; a stable pick of the templates that\nprefers an up-to-date one); Global Volumes are never deleted, so duplicates stop the request\nwith `cloud_volume_duplicated`. Idempotent: run it again after an interruption or a\ncredential rotation.",
      "properties": {
        "action": {
          "const": "setup_cloud",
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "SetupCloudRequest",
      "type": "object"
    },
    "StartReviewRequest": {
      "additionalProperties": false,
      "description": "Move a batch from `composing` to `reviewing`.",
      "properties": {
        "action": {
          "const": "start_review",
          "title": "Action",
          "type": "string"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        }
      },
      "required": [
        "action",
        "batch_id"
      ],
      "title": "StartReviewRequest",
      "type": "object"
    },
    "StoreCredentialsRequest": {
      "additionalProperties": false,
      "description": "Store credentials in the keyring; fields left out keep what is stored. Values are never echoed.",
      "properties": {
        "action": {
          "const": "store_credentials",
          "title": "Action",
          "type": "string"
        },
        "r2_access_key_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Token"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "R2 API token access key id."
        },
        "r2_bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/BucketName"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "R2 bucket name."
        },
        "r2_endpoint_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointUrl"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "R2 S3 API endpoint URL."
        },
        "r2_secret_access_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Token"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "R2 API token secret access key."
        },
        "runpod_api_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Token"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Runpod API key of the desktop app."
        }
      },
      "required": [
        "action"
      ],
      "title": "StoreCredentialsRequest",
      "type": "object"
    },
    "SubtitleFilter": {
      "additionalProperties": false,
      "description": "Match files by the languages of their (not forced) sidecar subtitles.",
      "properties": {
        "languages": {
          "items": {
            "$ref": "#/$defs/LanguageCode"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "rule": {
          "$ref": "#/$defs/SubtitleRule"
        }
      },
      "required": [
        "languages",
        "rule"
      ],
      "title": "SubtitleFilter",
      "type": "object"
    },
    "SubtitleRule": {
      "enum": [
        "all",
        "any",
        "missing_one"
      ],
      "type": "string"
    },
    "TargetLanguages": {
      "items": {
        "$ref": "#/$defs/WhisperLanguage"
      },
      "minItems": 1,
      "type": "array"
    },
    "Token": {
      "format": "password",
      "type": "string",
      "writeOnly": true
    },
    "ToolPath": {
      "$ref": "#/$defs/SetPath"
    },
    "TranscribeChoice": {
      "additionalProperties": false,
      "description": "Transcribe the file into the job's language from one audio track.",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/Ulid"
        },
        "kind": {
          "const": "transcribe",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "$ref": "#/$defs/WhisperLanguage"
        },
        "track_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audio track of a video file; none for an audio file (uploaded as it is).",
          "title": "Track Index"
        }
      },
      "required": [
        "kind",
        "item_id",
        "language"
      ],
      "title": "TranscribeChoice",
      "type": "object"
    },
    "Ulid": {
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "type": "string"
    },
    "UpdateSettingsRequest": {
      "additionalProperties": false,
      "description": "Replace the stored settings with these (needs no database; the last writer wins).",
      "properties": {
        "action": {
          "const": "update_settings",
          "title": "Action",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "required": [
        "action",
        "settings"
      ],
      "title": "UpdateSettingsRequest",
      "type": "object"
    },
    "WhisperLanguage": {
      "type": "string"
    }
  },
