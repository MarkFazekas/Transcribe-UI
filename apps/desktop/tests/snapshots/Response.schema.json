{
  "$defs": {
    "CheckCredentialsResponse": {
      "additionalProperties": false,
      "description": "Outcome per service; a failed check is reported here, not as an error response.",
      "properties": {
        "action": {
          "const": "check_credentials",
          "default": "check_credentials",
          "title": "Action",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ServiceCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "checks"
      ],
      "title": "CheckCredentialsResponse",
      "type": "object"
    },
    "CheckOutcome": {
      "enum": [
        "ok",
        "missing",
        "failed"
      ],
      "type": "string"
    },
    "CheckedService": {
      "const": "r2",
      "type": "string"
    },
    "CloudObjectKind": {
      "enum": [
        "global_volume",
        "secret",
        "template"
      ],
      "type": "string"
    },
    "CloudObjectOutcome": {
      "additionalProperties": false,
      "description": "What `setup_cloud` did with one object.",
      "properties": {
        "duplicates_removed": {
          "default": 0,
          "minimum": 0,
          "title": "Duplicates Removed",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/CloudObjectKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/SetupOutcome"
        }
      },
      "required": [
        "kind",
        "name",
        "object_id",
        "outcome",
        "duplicates_removed"
      ],
      "title": "CloudObjectOutcome",
      "type": "object"
    },
    "CloudObjectState": {
      "enum": [
        "ok",
        "missing",
        "outdated",
        "duplicated"
      ],
      "type": "string"
    },
    "CloudObjectStatus": {
      "additionalProperties": false,
      "description": "One object of the setup as found on Runpod.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CloudObjectKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "outdated_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Outdated Fields",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/CloudObjectState"
        }
      },
      "required": [
        "kind",
        "name",
        "state",
        "object_id",
        "outdated_fields"
      ],
      "title": "CloudObjectStatus",
      "type": "object"
    },
    "CloudSetupStatusResponse": {
      "additionalProperties": false,
      "description": "Whether `launch_worker` can use the cloud setup as it is.",
      "properties": {
        "action": {
          "const": "cloud_setup_status",
          "default": "cloud_setup_status",
          "title": "Action",
          "type": "string"
        },
        "cloud_objects": {
          "items": {
            "$ref": "#/$defs/CloudObjectStatus"
          },
          "title": "Cloud Objects",
          "type": "array"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "worker_image": {
          "title": "Worker Image",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "ready",
        "worker_image",
        "cloud_objects"
      ],
      "title": "CloudSetupStatusResponse",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "description": "One thing the user has to confirm before the request is carried out.",
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "field",
        "message",
        "details"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "CredentialName": {
      "enum": [
        "r2_endpoint_url",
        "r2_bucket",
        "r2_access_key_id",
        "r2_secret_access_key",
        "runpod_api_key"
      ],
      "type": "string"
    },
    "CredentialSource": {
      "enum": [
        "keyring",
        "environment",
        "missing"
      ],
      "type": "string"
    },
    "CredentialStatus": {
      "additionalProperties": false,
      "description": "Whether one credential is set, and where from.",
      "properties": {
        "environment_variable": {
          "title": "Environment Variable",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/CredentialName"
        },
        "source": {
          "$ref": "#/$defs/CredentialSource"
        }
      },
      "required": [
        "name",
        "environment_variable",
        "source"
      ],
      "title": "CredentialStatus",
      "type": "object"
    },
    "CredentialsStatusResponse": {
      "additionalProperties": false,
      "description": "Which credentials are set and where from (keyring first, then the environment).",
      "properties": {
        "action": {
          "const": "credentials_status",
          "default": "credentials_status",
          "title": "Action",
          "type": "string"
        },
        "credentials": {
          "items": {
            "$ref": "#/$defs/CredentialStatus"
          },
          "title": "Credentials",
          "type": "array"
        },
        "keyring": {
          "$ref": "#/$defs/KeyringState"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "keyring",
        "credentials"
      ],
      "title": "CredentialsStatusResponse",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "description": "What went wrong: a stable code, a human-readable message and structured details.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "The request failed; for most codes nothing was changed (see the code's documentation).",
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "error": {
          "$ref": "#/$defs/ErrorBody"
        },
        "status": {
          "const": "error",
          "default": "error",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "FileExtension": {
      "pattern": "^[a-z0-9]{1,16}$",
      "type": "string"
    },
    "FolderSelection": {
      "additionalProperties": false,
      "description": "Check state of a folder with at least one selected media file below it.",
      "properties": {
        "path": {
          "$ref": "#/$defs/LocalPath"
        },
        "state": {
          "$ref": "#/$defs/FolderState"
        }
      },
      "required": [
        "path",
        "state"
      ],
      "title": "FolderSelection",
      "type": "object"
    },
    "FolderState": {
      "enum": [
        "all",
        "partial"
      ],
      "type": "string"
    },
    "GetAppInfoResponse": {
      "additionalProperties": false,
      "description": "Versions of the running app.",
      "properties": {
        "action": {
          "const": "get_app_info",
          "default": "get_app_info",
          "title": "Action",
          "type": "string"
        },
        "app_version": {
          "title": "App Version",
          "type": "string"
        },
        "contracts_schema_version": {
          "title": "Contracts Schema Version",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "app_version",
        "contracts_schema_version"
      ],
      "title": "GetAppInfoResponse",
      "type": "object"
    },
    "GetSettingsResponse": {
      "additionalProperties": false,
      "description": "The stored settings and every Whisper language, sorted by code.",
      "properties": {
        "action": {
          "const": "get_settings",
          "default": "get_settings",
          "title": "Action",
          "type": "string"
        },
        "languages": {
          "items": {
            "$ref": "#/$defs/LanguageOption"
          },
          "title": "Languages",
          "type": "array"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "settings",
        "languages"
      ],
      "title": "GetSettingsResponse",
      "type": "object"
    },
    "JsonValue": {},
    "KeyringState": {
      "enum": [
        "available",
        "unavailable",
        "failed"
      ],
      "type": "string"
    },
    "LanguageOption": {
      "additionalProperties": false,
      "description": "A Whisper language as the settings page shows it.",
      "properties": {
        "alignment": {
          "title": "Alignment",
          "type": "boolean"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "enabled",
        "alignment"
      ],
      "title": "LanguageOption",
      "type": "object"
    },
    "LocalPath": {
      "type": "string"
    },
    "MediaExtensions": {
      "items": {
        "$ref": "#/$defs/FileExtension"
      },
      "type": "array"
    },
    "MediaKind": {
      "enum": [
        "audio",
        "video"
      ],
      "type": "string"
    },
    "NeedsConfirmation": {
      "additionalProperties": false,
      "description": "Nothing was changed: send the same request again with the listed fields set.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "confirmations": {
          "items": {
            "$ref": "#/$defs/Confirmation"
          },
          "minItems": 1,
          "title": "Confirmations",
          "type": "array"
        },
        "status": {
          "const": "needs_confirmation",
          "default": "needs_confirmation",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "action",
        "confirmations"
      ],
      "title": "NeedsConfirmation",
      "type": "object"
    },
    "PathFlavor": {
      "type": "string"
    },
    "PlacementDefaults": {
      "additionalProperties": false,
      "description": "Placement choices a download request is pre-filled with (§3.5).",
      "properties": {
        "folder_count": {
          "exclusiveMinimum": 0,
          "title": "Folder Count",
          "type": "integer"
        },
        "output_folder": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "overwrite": {
          "title": "Overwrite",
          "type": "boolean"
        },
        "strategy": {
          "$ref": "#/$defs/PlacementStrategy"
        }
      },
      "required": [
        "strategy",
        "output_folder",
        "folder_count",
        "overwrite"
      ],
      "title": "PlacementDefaults",
      "type": "object"
    },
    "PlacementStrategy": {
      "enum": [
        "next_to_media",
        "mirror",
        "flat",
        "flat_with_folders"
      ],
      "type": "string"
    },
    "PreviewSelectionResponse": {
      "additionalProperties": false,
      "description": "The selected files in scan order, the folders' check states and the totals.",
      "properties": {
        "action": {
          "const": "preview_selection",
          "default": "preview_selection",
          "title": "Action",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/SelectionCounts"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SelectedFile"
          },
          "title": "Files",
          "type": "array"
        },
        "folders": {
          "items": {
            "$ref": "#/$defs/FolderSelection"
          },
          "title": "Folders",
          "type": "array"
        },
        "path_flavor": {
          "$ref": "#/$defs/PathFlavor"
        },
        "root": {
          "$ref": "#/$defs/LocalPath"
        },
        "scan_id": {
          "$ref": "#/$defs/Ulid"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ScanWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "action",
        "scan_id",
        "root",
        "path_flavor",
        "files",
        "folders",
        "counts",
        "warnings"
      ],
      "title": "PreviewSelectionResponse",
      "type": "object"
    },
    "ScanCounts": {
      "additionalProperties": false,
      "description": "Totals of a scan.",
      "properties": {
        "audio_files": {
          "minimum": 0,
          "title": "Audio Files",
          "type": "integer"
        },
        "folders": {
          "minimum": 0,
          "title": "Folders",
          "type": "integer"
        },
        "subtitle_files": {
          "minimum": 0,
          "title": "Subtitle Files",
          "type": "integer"
        },
        "video_files": {
          "minimum": 0,
          "title": "Video Files",
          "type": "integer"
        }
      },
      "required": [
        "folders",
        "video_files",
        "audio_files",
        "subtitle_files"
      ],
      "title": "ScanCounts",
      "type": "object"
    },
    "ScanFile": {
      "additionalProperties": false,
      "description": "A media file found by the scan.",
      "properties": {
        "folder": {
          "minimum": 0,
          "title": "Folder",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "mtime_ns": {
          "title": "Mtime Ns",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/LocalPath"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "subtitles": {
          "items": {
            "$ref": "#/$defs/Sidecar"
          },
          "title": "Subtitles",
          "type": "array"
        }
      },
      "required": [
        "name",
        "path",
        "folder",
        "kind",
        "size_bytes",
        "mtime_ns",
        "subtitles"
      ],
      "title": "ScanFile",
      "type": "object"
    },
    "ScanFolder": {
      "additionalProperties": false,
      "description": "A folder holding media files at some depth; index 0 is the scan root.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "path": {
          "$ref": "#/$defs/LocalPath"
        }
      },
      "required": [
        "name",
        "path",
        "parent"
      ],
      "title": "ScanFolder",
      "type": "object"
    },
    "ScanTreeResponse": {
      "additionalProperties": false,
      "description": "The media tree, flattened: folders in depth-first order, files grouped by folder.",
      "properties": {
        "action": {
          "const": "scan_tree",
          "default": "scan_tree",
          "title": "Action",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/ScanCounts"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/ScanFile"
          },
          "title": "Files",
          "type": "array"
        },
        "folders": {
          "items": {
            "$ref": "#/$defs/ScanFolder"
          },
          "title": "Folders",
          "type": "array"
        },
        "path_flavor": {
          "$ref": "#/$defs/PathFlavor"
        },
        "root": {
          "$ref": "#/$defs/LocalPath"
        },
        "scan_id": {
          "$ref": "#/$defs/Ulid"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ScanWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status",
        "action",
        "scan_id",
        "root",
        "path_flavor",
        "folders",
        "files",
        "counts",
        "warnings"
      ],
      "title": "ScanTreeResponse",
      "type": "object"
    },
    "ScanWarning": {
      "additionalProperties": false,
      "description": "An entry left out of the scan, or a selection path that matched nothing.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ScanWarningCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/LocalPath"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "title": "ScanWarning",
      "type": "object"
    },
    "ScanWarningCode": {
      "enum": [
        "invalid_name",
        "link_skipped",
        "unreadable",
        "too_deep",
        "no_media_at_path"
      ],
      "type": "string"
    },
    "SelectedFile": {
      "additionalProperties": false,
      "description": "A selected media file and the subtitles it already has.",
      "properties": {
        "forced_subtitle_languages": {
          "items": {
            "type": "string"
          },
          "title": "Forced Subtitle Languages",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/LocalPath"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "subtitle_languages": {
          "items": {
            "type": "string"
          },
          "title": "Subtitle Languages",
          "type": "array"
        },
        "unknown_language_subtitles": {
          "minimum": 0,
          "title": "Unknown Language Subtitles",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "path",
        "kind",
        "size_bytes",
        "subtitle_languages",
        "forced_subtitle_languages",
        "unknown_language_subtitles"
      ],
      "title": "SelectedFile",
      "type": "object"
    },
    "SelectionCounts": {
      "additionalProperties": false,
      "description": "Totals of a selection.",
      "properties": {
        "audio_files": {
          "minimum": 0,
          "title": "Audio Files",
          "type": "integer"
        },
        "files": {
          "minimum": 0,
          "title": "Files",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "video_files": {
          "minimum": 0,
          "title": "Video Files",
          "type": "integer"
        }
      },
      "required": [
        "files",
        "video_files",
        "audio_files",
        "size_bytes"
      ],
      "title": "SelectionCounts",
      "type": "object"
    },
    "ServiceCheck": {
      "additionalProperties": false,
      "description": "Outcome of trying one service's credentials.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "service": {
          "$ref": "#/$defs/CheckedService"
        }
      },
      "required": [
        "service",
        "outcome",
        "code",
        "message"
      ],
      "title": "ServiceCheck",
      "type": "object"
    },
    "SetPath": {
      "type": "string"
    },
    "Settings": {
      "additionalProperties": false,
      "description": "The user's settings (all fields required; see `state.settings.default_settings`).",
      "properties": {
        "audio_extensions": {
          "$ref": "#/$defs/MediaExtensions"
        },
        "enabled_languages": {
          "items": {
            "$ref": "#/$defs/WhisperLanguage"
          },
          "minItems": 1,
          "title": "Enabled Languages",
          "type": "array"
        },
        "ffmpeg_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "ffprobe_path": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "include_hidden": {
          "title": "Include Hidden",
          "type": "boolean"
        },
        "placement": {
          "$ref": "#/$defs/PlacementDefaults"
        },
        "video_extensions": {
          "$ref": "#/$defs/MediaExtensions"
        }
      },
      "required": [
        "enabled_languages",
        "video_extensions",
        "audio_extensions",
        "include_hidden",
        "ffmpeg_path",
        "ffprobe_path",
